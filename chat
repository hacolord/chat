-- ======================================================================
-- NHÁNH 4: LỚP TRUYỀN TẢI (TRANSPORT LAYER - FIREBASE REST)
-- ======================================================================

local CONFIG = {
    DB_URL = "https://chat-776fd-default-rtdb.asia-southeast1.firebasedatabase.app"
}

local Transport = {}

function Transport.fetchMessages()
    if not req then return nil end
    local success, res = pcall(function()
        local response = req({
            Url = CONFIG.DB_URL .. "/chat.json?orderBy=\"$key\"&limitToLast=50",
            Method = "GET"
        })
        if response and response.Success and response.Body then
            local data = HttpService:JSONDecode(response.Body)
            if type(data) == "table" then
                local list = {}
                for key, val in pairs(data) do
                    if type(val) == "table" then
                        val._key = key
                        table.insert(list, val)
                    end
                end
                table.sort(list, function(a, b)
                    return (a.ts or 0) < (b.ts or 0)
                end)
                return list
            end
        end
    end)
    if not success then
        warn("[CHAT]: Lỗi khi tải tin nhắn: " .. tostring(res))
    end
    return nil
end

function Transport.sendMessage(msgData)
    if not req then return false end
    local success, res = pcall(function()
        local body = HttpService:JSONEncode({
            uid = tostring(localPlayer.UserId),
            name = localPlayer.Name,
            display = localPlayer.DisplayName,
            text = msgData.text,
            mentions = msgData.mentions or {},
            ts = { [".sv"] = "timestamp" }
        })
        local response = req({
            Url = CONFIG.DB_URL .. "/chat.json",
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = body
        })
        return response and response.Success
    end)
    if not success then
        warn("[CHAT]: Lỗi khi gửi tin nhắn: " .. tostring(res))
        return false
    end
    return success
end

