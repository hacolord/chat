            end,
        })

        -- Sắp xếp tab Chat lên đầu tiên bên trái
        local coreGuiInstance = gethui()
        local function sortTabs()
            for _, gui in ipairs(coreGuiInstance:GetChildren()) do
                if gui:IsA("ScreenGui") and gui:FindFirstChild("Main") then
                    local main = gui.Main
                    local tabList = main:FindFirstChild("TabList")
                    local elements = main:FindFirstChild("Elements")
                    if tabList and tabList:FindFirstChild("UIListLayout") then
                        tabList.UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
                        for _, child in ipairs(tabList:GetChildren()) do
                            if child:IsA("TextButton") and child.Text == "Chat" then
                                child.LayoutOrder = -1
                            end
                        end
                    end
                    if elements then
                        for _, child in ipairs(elements:GetChildren()) do
                            if child.Name == "Chat" then
                                child.LayoutOrder = -1
                            end
                        end
                    end
                end
            end
        end
        sortTabs()
    end)
end)

