-- ================= [ NHÁNH 1: TRANSPORT & FIREBASE ] =================
local Transport = {}

function Transport.fetchMessages()
    local success, result = pcall(function()
        if not req then return nil end
        local url = CONFIG.DB_URL .. "/chat.json?orderBy=\"$key\"&limitToLast=50"
        local response = req({
            Url = url,
            Method = "GET"
        })
        if response and response.Success and response.Body then
            if response.Body ~= "null" and response.Body ~= "" then
                return HttpService:JSONDecode(response.Body)
            end
        end
        return nil
    end)
    if not success then
        warn("[CHAT]: Lỗi tải tin nhắn từ Firebase: " .. tostring(result))
        return nil
    end
    return result
end

function Transport.sendMessage(msgData)
    local success, result = pcall(function()
        if not req then return false end
        local url = CONFIG.DB_URL .. "/chat.json"
        local response = req({
            Url = url,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(msgData)
        })
        return response and response.Success
    end)
    if not success then
        warn("[CHAT]: Lỗi gửi tin nhắn lên Firebase: " .. tostring(result))
        return false
    end
    return result
end

