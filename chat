-- ================= [ NHÁNH 4: CHAT LOGIC & RENDER ] =================
local renderedMessages = {}
local processedKeys = {}
local lastSendTime = 0

local function addMessageToUI(firebaseKey, name, display, text, isSelf)
    if processedKeys[firebaseKey] then return end
    processedKeys[firebaseKey] = true

    if #messageScrolling:GetChildren() > 101 then
        local oldest = messageScrolling:GetChildren()[2]
        if oldest and oldest:IsA("TextLabel") then
            oldest:Destroy()
        end
    end

    local msgLabel = Instance.new("TextLabel")
    msgLabel.Size = UDim2.new(1, 0, 0, 0)
    msgLabel.AutomaticSize = Enum.AutomaticSize.Y
    msgLabel.BackgroundTransparency = 1
    msgLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
    msgLabel.TextSize = 12
    msgLabel.Font = Enum.Font.SourceSans
    msgLabel.TextXAlignment = Enum.TextXAlignment.Left
    msgLabel.TextWrapped = true
    msgLabel.Text = string.format("%s (@%s): %s", display, name, text)
    msgLabel.Parent = messageScrolling

    if isSelf then
        Instance.new("UIStroke", msgLabel).Color = Color3.fromRGB(50, 150, 250)
    end

    local isAtBottom = (messageScrolling.CanvasPosition.Y >= messageScrolling.AbsoluteCanvasSize.Y - messageScrolling.AbsoluteWindowSize.Y - 20)
    if isAtBottom then
        messageScrolling.CanvasPosition = Vector2.new(0, messageScrolling.AbsoluteCanvasSize.Y)
    end
end

local function executeSend()
    local text = chatTextBox.Text
    if text == "" or #text > 200 then return end
    if tick() - lastSendTime < 2 then return end
    lastSendTime = tick()

    chatTextBox.Text = ""

    local mentions = {}
    for mention in string.gmatch(text, "@([%w_]+)") do
        table.insert(mentions, mention)
    end

    local payload = {
        uid = tostring(localPlayer.UserId),
        name = localPlayer.Name,
        display = localPlayer.DisplayName,
        text = text,
        mentions = mentions,
        ts = { [".sv"] = "timestamp" }
    }

    if CONFIG.LOCAL_ECHO then
        addMessageToUI("local_" .. tick(), localPlayer.Name, localPlayer.DisplayName, text, true)
    end

    task.spawn(function()
        Transport.sendMessage(payload)
    end)
end

chatTextBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then executeSend() end
end)
sendButton.MouseButton1Click:Connect(executeSend)

-- Vòng lặp đồng bộ mạng & đếm ngược duy nhất
task.spawn(function()
    local firstLoad = true
    while _G.HubState.chatAlive and _G.HubState.chatRunId == currentRunId do
        if not _G.HubState.chatOpen then
            task.wait(0.5)
        else
            _G.HubState.chatCountdown = _G.HubState.chatRefreshRate
            while _G.HubState.chatCountdown > 0 and _G.HubState.chatOpen and _G.HubState.chatAlive and _G.HubState.chatRunId == currentRunId do
                countdownLabel.Text = _G.HubState.chatCountdown .. "s"
                task.wait(1)
                _G.HubState.chatCountdown = _G.HubState.chatCountdown - 1
            end

            if _G.HubState.chatOpen and _G.HubState.chatAlive and _G.HubState.chatRunId == currentRunId then
                countdownLabel.Text = "0s"
                local data = Transport.fetchMessages()
                if data and type(data) == "table" then
                    for k, v in pairs(data) do
                        if type(v) == "table" and v.text and v.name then
                            if not processedKeys[k] then
                                local isSelf = (v.name == localPlayer.Name)
                                if not firstLoad and not isSelf then
                                    local isMentioned = false
                                    if v.mentions then
                                        for _, m in ipairs(v.mentions) do
                                            if string.lower(m) == string.lower(localPlayer.Name) then
                                                isMentioned = true
                                                break
                                            end
                                        end
                                    end
                                    if _G.HubState.chatNotifyEnabled or isMentioned then
                                        showNotification(v.name, v.display or v.name, tonumber(v.uid) or 0, v.text)
                                    end
                                end
                                addMessageToUI(k, v.name, v.display or v.name, v.text, isSelf)
                            end
                        end
                    end
                end
                firstLoad = false
            end
        end
    end
end)

-- ================= [ NHÁNH 5: RAYFIELD TAB & LOGIC HOOK ] =================
_G.HubLogic.ChatOpen = function()
    _G.HubState.chatOpen = true
    if _G.HubState.IndependentChatGui then
        _G.HubState.IndependentChatGui.Enabled = true
    end
end

_G.HubLogic.ChatClose = function()
    _G.HubState.chatOpen = false
    if _G.HubState.IndependentChatGui then
        _G.HubState.IndependentChatGui.Enabled = false
    end
end

_G.HubLogic.ChatRefreshNow = function()
    _G.HubState.chatCountdown = 0
end

_G.HubLogic.ChatSetRate = function(rate)
    local num = tonumber(rate)
    if num and num >= 1 and num <= 10 then
        _G.HubState.chatRefreshRate = math.floor(num + 0.5)
    elseif num and num > 10 then
        _G.HubState.chatRefreshRate = 10
    end
end

