local renderedMessages = {}
local lastSendTick = 0
local forceRefreshEvent = Instance.new("BindableEvent")

local function isUserAtBottom()
    return (chatScrollingFrame.CanvasPosition.Y + chatScrollingFrame.AbsoluteWindowSize.Y) >= (chatScrollingFrame.AbsoluteCanvasSize.Y - 20)
end

local function renderMessage(msg)
    if not msg or not msg._key then return end
    if renderedMessages[msg._key] then return end
    renderedMessages[msg._key] = true

    pcall(function()
        local atBottom = isUserAtBottom()

        local msgFrame = Instance.new("Frame")
        msgFrame.Size = UDim2.new(1, 0, 0, 0)
        msgFrame.AutomaticSize = Enum.AutomaticSize.Y
        msgFrame.BackgroundTransparency = 1
        msgFrame.Parent = chatScrollingFrame

        local isOwn = (tostring(msg.uid) == tostring(localPlayer.UserId))
        local isMentioned = false
        if msg.mentions then
            for _, m in ipairs(msg.mentions) do
                if m:lower() == localPlayer.Name:lower() then
                    isMentioned = true
                    break
                end
            end
        end

        local inner = Instance.new("Frame")
        inner.Size = UDim2.new(1, 0, 0, 0)
        inner.AutomaticSize = Enum.AutomaticSize.Y
        inner.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        inner.BorderSizePixel = 0
        inner.Parent = msgFrame
        Instance.new("UICorner", inner).CornerRadius = UDim.new(0, 6)

        if isMentioned or isOwn then
            local stroke = Instance.new("UIStroke")
            stroke.Color = isOwn and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(255, 170, 0)
            stroke.Thickness = 1.5
            stroke.Parent = inner
        end

        local padding = Instance.new("UIPadding")
        padding.PaddingTop = UDim.new(0, 6)
        padding.PaddingBottom = UDim.new(0, 6)
        padding.PaddingLeft = UDim.new(0, 8)
        padding.PaddingRight = UDim.new(0, 8)
        padding.Parent = inner

        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 0, 0)
        textLabel.AutomaticSize = Enum.AutomaticSize.Y
        textLabel.BackgroundTransparency = 1
        textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        textLabel.TextSize = 13
        textLabel.Font = Enum.Font.SourceSans
        textLabel.TextXAlignment = Enum.TextXAlignment.Left
        textLabel.TextWrapped = true
        textLabel.RichText = false
        textLabel.Text = string.format("%s (@%s):\n%s", msg.display or "Unknown", msg.name or "User", msg.text or "")
        textLabel.Parent = inner

        if #chatScrollingFrame:GetChildren() > 100 then
            local oldest = chatScrollingFrame:GetChildren()[1]
            if oldest and oldest:IsA("Frame") then
                oldest:Destroy()
            end
        end

        if atBottom then
            chatScrollingFrame.CanvasPosition = Vector2.new(0, chatScrollingFrame.AbsoluteCanvasSize.Y)
        end
    end)
end

local function extractMentions(text)
    local mentions = {}
    for name in string.gmatch(text, "@([%w_]+)") do
        table.insert(mentions, name)
    end
    return mentions
end

function _G.HubLogic.ChatSend()
    local text = chatTextBox.Text
    if not text or text == "" then return end
    if tick() - lastSendTick < 2 then return end
    if #text > 200 then text = string.sub(text, 1, 200) end
    lastSendTick = tick()

    chatTextBox.Text = ""

    local mentions = extractMentions(text)
    local localMsg = {
        _key = "local_" .. tostring(tick()),
        uid = tostring(localPlayer.UserId),
        name = localPlayer.Name,
        display = localPlayer.DisplayName,
        text = text,
        mentions = mentions,
        ts = tick() * 1000
    }
    renderMessage(localMsg)

    task.spawn(function()
        Transport.sendMessage({ text = text, mentions = mentions })
        forceRefreshEvent:Fire()
    end)
end

sendBtn.MouseButton1Click:Connect(_G.HubLogic.ChatSend)
chatTextBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        _G.HubLogic.ChatSend()
    end
end)

function _G.HubLogic.ChatRefreshNow()
    forceRefreshEvent:Fire()
end

function _G.HubLogic.ChatSetNotify(val)
    _G.HubState.chatNotifyEnabled = val
    Toggle_ChatNotify:Set(val)
    strikeThrough.Visible = not val
end

function _G.HubLogic.ChatSetRate(val)
    if val and val > 0 and val <= 600 then
        _G.HubState.chatRefreshRate = val
        Input_ChatRefreshRate:Set(tostring(val))
    end
end

function _G.HubLogic.ChatDestroy()
    _G.HubState.chatAlive = false
    if notifyGui then notifyGui:Destroy() end
    if customChatContainer then customChatContainer:Destroy() end
end

notifyBtn.MouseButton1Click:Connect(function()
    local newVal = not _G.HubState.chatNotifyEnabled
    _G.HubLogic.ChatSetNotify(newVal)
end)

-- ======================================================================
-- NHÁNH 8: VÒNG LẶP CHẠY NỀN & THÔNG BÁO
-- ======================================================================

local isFirstLoad = true

task.spawn(function()
    local backoff = 1
    while _G.HubState.chatAlive and _G.HubState.chatRunId == currentRunId do
        local msgs = Transport.fetchMessages()
        if msgs then
            backoff = 1
            for _, msg in ipairs(msgs) do
                if isFirstLoad then
                    renderedMessages[msg._key] = true
                else
                    if not renderedMessages[msg._key] then
                        if tostring(msg.uid) ~= tostring(localPlayer.UserId) then
                            showNotificationBanner(msg)
                        end
                    end
                end
                renderMessage(msg)
            end
            isFirstLoad = false
        else
            backoff = math.min(backoff * 2, 60)
        end

        local currentRate = _G.HubState.chatRefreshRate or 5
        local remaining = currentRate
        while remaining > 0 and _G.HubState.chatAlive and _G.HubState.chatRunId == currentRunId do
            _G.HubState.chatCountdown = remaining
            pcall(function()
                countdownLabel.Text = tostring(remaining) .. "s trước làm mới"
            end)
            
            local fired = false
            local conn
            conn = forceRefreshEvent.Event:Connect(function()
                fired = true
                if conn then conn:Disconnect() end
            end)

            local elapsed = 0
            while elapsed < 1 and not fired and _G.HubState.chatAlive and _G.HubState.chatRunId == currentRunId do
                task.wait(0.1)
                elapsed = elapsed + 0.1
            end
            if conn then conn:Disconnect() end

            if fired then break end
            remaining = remaining - 1
        end
    end
end)

