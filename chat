local function showNotificationBanner(msg)
    if not _G.HubState.chatNotifyEnabled then
        local isMentioned = false
        if msg.mentions then
            for _, m in ipairs(msg.mentions) do
                if m:lower() == localPlayer.Name:lower() then
                    isMentioned = true
                    break
                end
            end
        end
        if not isMentioned then return end
    end

    local function isChatTabVisible()
        local success, result = pcall(function()
            local gui = gethui()
            local rayfieldGui = gui:FindFirstChild("Rayfield") or playerGui:FindFirstChild("Rayfield")
            if rayfieldGui then
                local mainFrame = rayfieldGui:FindFirstChild("Main", true)
                if mainFrame and mainFrame.Visible then
                    local elements = mainFrame:FindFirstChild("Elements", true)
                    if elements then
                        for _, child in ipairs(elements:GetChildren()) do
                            if (child.Name == "Chat" or child.Name:lower():find("chat")) and child.Visible then
                                return true
                            end
                        end
                    end
                end
            end
            return false
        end)
        if success then return result end
        return false
    end

    if isChatTabVisible() then return end

    table.insert(notificationQueue, msg)
    if #notificationQueue > 5 then
        table.remove(notificationQueue, 1)
    end

    pcall(function()
        local thumbUrl = ""
        pcall(function()
            local content, isReady = Players:GetUserThumbnailAsync(tonumber(msg.uid) or 1, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size42x42)
            if isReady then thumbUrl = content end
        end)

        local banner = Instance.new("TextButton")
        banner.Name = "ChatBanner"
        banner.Size = UDim2.new(0, 320, 0, 50)
        banner.Position = UDim2.new(0.5, -160, 0, 10 + (#activeBanners * 55))
        banner.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        banner.BorderSizePixel = 0
        banner.AutoButtonColor = false
        banner.Text = ""
        banner.Parent = notifyGui
        Instance.new("UICorner", banner).CornerRadius = UDim.new(0, 10)

        local icon = Instance.new("ImageLabel")
        icon.Size = UDim2.new(0, 36, 0, 36)
        icon.Position = UDim2.new(0, 7, 0, 7)
        icon.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        icon.Image = thumbUrl
        icon.Parent = banner
        Instance.new("UICorner", icon).CornerRadius = UDim.new(0, 6)

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -50, 1, 0)
        label.Position = UDim2.new(0, 48, 0, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextSize = 13
        label.Font = Enum.Font.SourceSans
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.RichText = false
        label.Text = string.format("%s (@%s)\n%s", msg.display or "Unknown", msg.name or "User", msg.text or "")
        label.Parent = banner

        table.insert(activeBanners, banner)

        banner.MouseButton1Click:Connect(function()
            banner:Destroy()
            for i, b in ipairs(activeBanners) do
                if b == banner then
                    table.remove(activeBanners, i)
                    break
                end
            end
        end)

        task.spawn(function()
            task.wait(4)
            if banner and banner.Parent then
                banner:Destroy()
                for i, b in ipairs(activeBanners) do
                    if b == banner then
                        table.remove(activeBanners, i)
                        break
                    end
                end
